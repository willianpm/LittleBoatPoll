# Environment example for LittleBoatPoll
# Copy to .env or .env.staging, then customize values.

# Running environment
APP_ENV=prod

# Redis session persistence (required for prod)
REDIS_URL=redis://:your_redis_password@redis:6379
REDIS_PASSWORD=your_redis_password

# Discord bot credentials
TOKEN=your_discord_bot_token               # required
CLIENT_ID=your_discord_app_id              # required
CLIENT_SECRET=your_discord_app_secret      # optional
GUILD_ID=your_primary_guild_id             # optional

# Dashboard OAuth2 settings
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost/api/auth/discord/callback
DASHBOARD_SESSION_SECRET=replace_this_secret
DASHBOARD_ALLOWED_GUILD_ID=your_primary_guild_id
DASHBOARD_FRONTEND_URL=http://localhost
DASHBOARD_SINGLE_INSTANCE=true

# Control flags
DEPLOY=false
DEBUG=false
PORT=8000

# Security note: Never commit real secrets or tokens.

